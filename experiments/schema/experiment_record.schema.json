{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-research.local/schemas/experiment-record-v1.0.json",
  "title": "Research Experiment Record V1.0",
  "type": "object",
  "required": [
    "experiment_id",
    "project_id",
    "strategy_id",
    "strategy_version",
    "research_stage",
    "title",
    "gate",
    "experiment_type",
    "hypothesis",
    "description",
    "scope",
    "lineage",
    "reproducibility",
    "status",
    "decision",
    "confirmatory",
    "reserved_data_exposed",
    "summary_metrics",
    "artifacts"
  ],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "strategy_version": {"type": ["string", "null"]},
    "research_stage": {
      "enum": [
        "STAGE_0_IDEA",
        "STAGE_1_DATA",
        "STAGE_2_FEATURES",
        "STAGE_3_SIGNALS",
        "STAGE_4_EXECUTION",
        "STAGE_5_BASELINE",
        "STAGE_6_EXPLORATION",
        "STAGE_7_ROBUSTNESS",
        "STAGE_8_FREEZE",
        "STAGE_9_VALIDATION",
        "STAGE_10_DIAGNOSIS",
        "STAGE_11_DECISION"
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "gate": {"type": ["string", "null"]},
    "experiment_type": {"type": "string", "minLength": 1},
    "hypothesis": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "scope": {
      "type": "object",
      "required": ["instrument_id", "universe_id", "asset_class", "timeframe", "partition"],
      "properties": {
        "instrument_id": {"type": ["string", "null"]},
        "universe_id": {"type": ["string", "null"]},
        "asset_class": {"type": ["string", "null"]},
        "timeframe": {"type": ["string", "null"]},
        "partition": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        }
      },
      "additionalProperties": true
    },
    "lineage": {
      "type": "object",
      "required": ["parent_experiment_ids", "source_gates"],
      "properties": {
        "parent_experiment_ids": {"type": "array", "items": {"type": "string"}},
        "source_gates": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "reproducibility": {
      "type": "object",
      "required": ["dataset_id", "data_hash", "config_path", "git_sha", "run_timestamp"],
      "properties": {
        "dataset_id": {"type": ["string", "null"]},
        "data_hash": {"type": ["string", "null"]},
        "config_path": {"type": ["string", "null"]},
        "git_sha": {"type": ["string", "null"]},
        "run_timestamp": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "data_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dataset_id", "role"],
        "properties": {
          "dataset_id": {"type": ["string", "null"]},
          "role": {"type": "string"},
          "path": {"type": ["string", "null"]},
          "hash": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "configuration": {
      "type": "object",
      "required": ["path", "parameters"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "parameters": {"type": "object"}
      },
      "additionalProperties": true
    },
    "status": {"enum": ["planned", "running", "complete", "failed"]},
    "decision": {"enum": ["continue", "freeze", "pass", "revise", "reject", "diagnostic", "none"]},
    "confirmatory": {"type": "boolean"},
    "reserved_data_exposed": {"type": "boolean"},
    "summary_metrics": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "type", "title", "path"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "type": {
            "enum": ["chart", "table", "csv", "data", "feature_audit", "signal_audit", "execution_audit", "trade_audit", "candidate_audit", "metadata", "config", "configuration", "report", "log", "source", "test", "freeze", "summary", "other"]
          },
          "title": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "description": {"type": ["string", "null"]},
          "mime_type": {"type": ["string", "null"]},
          "category": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "metadata_path": {"type": ["string", "null"]},
    "artifact_patterns": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]},
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "future_hypotheses": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
