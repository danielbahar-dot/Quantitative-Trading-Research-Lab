# Python environments, bytecode, caches, and test artifacts
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Local environment files (an example file may be committed intentionally)
.env
.env.*
!.env.example

# IDE and operating-system metadata
.idea/
.vscode/
*.suo
*.user
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Market-data artifacts can be large or licensed. Keep directory placeholders.
data/**/*.csv
data/**/*.parquet
data/**/*.feather
data/**/*.arrow
data/**/*.h5
data/**/*.hdf5
data/**/*.npy
data/**/*.npz
!data/**/.gitkeep
# Derived-timeframe cache (Parquet + manifests); rebuildable, never authoritative.
data/derived/

# M5A visual-validation chart embeds raw 1m market prices; keep it local.
# The price-free *_cases.csv next to it is the tracked audit artifact.
reports/validation/m5a_market_context_visual_validation.html
# M6A visual-validation chart likewise embeds raw prices; its *_cases.csv and
# *_dev_summary.csv are price-free and tracked.
reports/validation/m6a_level_interactions_visual_validation.html
# External Liquidity visual-validation chart embeds raw prices; the price-free
# external_liquidity_dev_*.csv and *_cases.csv next to it are tracked.
reports/validation/external_liquidity_visual_validation.html
# Swing Structure 3.2 design-evidence chart embeds raw prices; keep it local.
reports/validation/swing_structure_design_visual.html
# Swing Structure SW-I3 implementation visual and full candidate audit embed raw
# prices; the price-free swing_structure_dev_*.csv and *_cases.csv are tracked.
reports/validation/swing_structure_visual_validation.html
reports/validation/swing_structure_dev_candidate_audit.csv.gz

# Experiment ledgers and run outputs are generated and remain local.
experiments/experiment_ledger.sqlite
experiments/experiment_ledger.sqlite-*
experiments/ledger.csv
experiments/runs/*
!experiments/runs/.gitkeep

# Timestamped working backups are local safety copies.
backups/

# Logs and temporary/generated output
*.log
*.tmp
*.bak
logs/
tmp/
temp/
output/
outputs/
# Market Structure visual-validation chart embeds raw prices; the price-free
# *_cases.csv manifest and summary CSVs are tracked.
reports/validation/market_structure_visual_validation.html
# Internal Liquidity visual-validation chart embeds raw prices; the price-free
# *_cases.csv manifest and summary CSVs are tracked.
reports/validation/internal_liquidity_visual_validation.html
# FVG / IFVG / BPR visual-validation chart embeds raw prices; the price-free
# fvg_visual_validation_cases.csv manifest is tracked.
reports/validation/fvg_visual_validation.html
# FVG fast validation tier (window runs) is local scratch evidence; only full-DEVELOPMENT evidence is tracked.
reports/validation/fvg_fast/
